# Python environment and generated bytecode
.venv/
venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.py[cod]
*.pyo
.coverage
.coverage.*
htmlcov/

# Local environment files, credentials, and tokens
.env
.env.*
!.env.example
**/*token*
**/*oauth*
**/*credential*
**/*secret*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
config/*
!config/.gitkeep
!config/*.example.json

# Logs
*.log
logs/*
!logs/.gitkeep

# Downloaded files, reports, workbooks, and student data
*.pdf
*.csv
*.xlsx
*.xls
output/*
!output/.gitkeep
sample_data/*
!sample_data/.gitkeep
